# Notion ページID・ビューIDの設定
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env

# 検証用CRM ページID
NOTION_CRM_PAGE_ID=

# 検証用ダッシュボード ページID
NOTION_DASHBOARD_PAGE_ID=

# Deals データソースURL (collection://... 形式)
# notion-fetch は view:// 非対応のため、data source URL を直接指定する
NOTION_DEALS_DATA_SOURCE_URL=

# Activities データソースURL (collection://... 形式)
# Deal Strategist の Engagement 補強用。Deals に対するリレーションで紐付く
NOTION_ACTIVITIES_DATA_SOURCE_URL=
